{
  "name": "trueblink",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Wavelength-honest blink comparator for NASA SPHEREx images (NASA Space Apps Challenge 2026, Planet X and SPHEREx)",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:site": "node scripts/build-site.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run tests/live",
    "bake": "tsx scripts/bake-presets.ts",
    "relay": "node scripts/relay.mjs",
    "serve": "node scripts/serve.mjs",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node e2e/app-live.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "^1.56.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
